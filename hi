-- State variables
local spectatingPlayer = nil
local currentIndex = 0

-- Helper function to get players excluding local player
local function getFilteredPlayers()
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			table.insert(list, p)
		end
	end
	return list
end

-- Find player matching typed string (case-insensitive partial search)
local function findPlayer(nameInput)
	nameInput = string.lower(nameInput)
	for _, p in ipairs(getFilteredPlayers()) do
		if string.sub(string.lower(p.Name), 1, #nameInput) == nameInput or string.sub(string.lower(p.DisplayName), 1, #nameInput) == nameInput then
			return p
		end
	end
	return nil
end

local function updateSpectate(target)
	spectatingPlayer = target
	if spectatingPlayer then
		targetLabel.Text = "Spectating: " .. spectatingPlayer.Name
		if spectatingPlayer.Character and spectatingPlayer.Character:FindFirstChildOfClass("Humanoid") then
			camera.CameraSubject = spectatingPlayer.Character:FindFirstChildOfClass("Humanoid")
		end
		-- Sync index with filtered list
		local filtered = getFilteredPlayers()
		for i, p in ipairs(filtered) do
			if p == spectatingPlayer then
				currentIndex = i
				break
			end
		end
	else
		targetLabel.Text = "Player not found"
	end
end

-- Connect Spectate Button & Enter Key
spectateButton.MouseButton1Click:Connect(function()
	if nameBox.Text ~= "" then
		local found = findPlayer(nameBox.Text)
		updateSpectate(found)
	end
end)

nameBox.FocusLost:Connect(function(enterPressed)
	if enterPressed and nameBox.Text ~= "" then
		local found = findPlayer(nameBox.Text)
		updateSpectate(found)
	end
end)

-- Connect Next Player Button
nextButton.MouseButton1Click:Connect(function()
	local filtered = getFilteredPlayers()
	if #filtered == 0 then
		targetLabel.Text = "No players available"
		return
	end
	currentIndex = currentIndex + 1
	if currentIndex > #filtered then
		currentIndex = 1
	end
	updateSpectate(filtered[currentIndex])
end)

-- Connect Stop Button
stopButton.MouseButton1Click:Connect(function()
	spectatingPlayer = nil
	currentIndex = 0
	targetLabel.Text = "Spectating: None"
	nameBox.Text = ""
	if player.Character and player.Character:FindFirstChildOfClass("Humanoid") then
		camera.CameraSubject = player.Character:FindFirstChildOfClass("Humanoid")
	end
end)

-- Keep camera locked onto target if they reset/respawn
RunService.RenderStepped:Connect(function()
	if spectatingPlayer and spectatingPlayer.Character then
		local humanoid = spectatingPlayer.Character:FindFirstChildOfClass("Humanoid")
		if humanoid and camera.CameraSubject ~= humanoid then
			camera.CameraSubject = humanoid
		end
	end
end)

-- Dragging Logic for the Outer Window
local dragging = false
local dragStart, startPos

mainFrame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = mainFrame.Position
		
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		mainFrame.Position = UDim2.new(
			startPos.X.Scale, 
			startPos.X.Offset + delta.X, 
			startPos.Y.Scale, 
			startPos.Y.Offset + delta.Y
		)
	end
end)
