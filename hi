-- Spectate State
local spectatingPlayer = nil
local currentIndex = 0

local function getFilteredPlayers()
    local list = {}

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            table.insert(list, p)
        end
    end

    return list
end

local function findPlayer(input)
    input = string.lower(input)

    if input == "" then
        return nil
    end

    for _, p in ipairs(getFilteredPlayers()) do
        local username = string.lower(p.Name)
        local displayName = string.lower(p.DisplayName)

        if string.find(username, input, 1, true)
        or string.find(displayName, input, 1, true) then
            return p
        end
    end

    return nil
end

local function updateSpectate(target)
    if not target then
        targetLabel.Text = "Player not found"
        return
    end

    spectatingPlayer = target
    targetLabel.Text = "Spectating: " .. target.Name

    local character = target.Character
    local humanoid = character
        and character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        camera = workspace.CurrentCamera
        camera.CameraType = Enum.CameraType.Custom
        camera.CameraSubject = humanoid
    end

    local filtered = getFilteredPlayers()

    for i, p in ipairs(filtered) do
        if p == target then
            currentIndex = i
            break
        end
    end
end

local function stopSpectating()
    spectatingPlayer = nil
    currentIndex = 0

    targetLabel.Text = "Spectating: None"
    nameBox.Text = ""

    local character = player.Character
    local humanoid = character
        and character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        camera = workspace.CurrentCamera
        camera.CameraType = Enum.CameraType.Custom
        camera.CameraSubject = humanoid
    end
end

-- Spectate Button
spectateButton.MouseButton1Click:Connect(function()
    if nameBox.Text ~= "" then
        updateSpectate(findPlayer(nameBox.Text))
    end
end)

-- Enter Key
nameBox.FocusLost:Connect(function(enterPressed)
    if enterPressed and nameBox.Text ~= "" then
        updateSpectate(findPlayer(nameBox.Text))
    end
end)

-- Next Player
nextButton.MouseButton1Click:Connect(function()
    local filtered = getFilteredPlayers()

    if #filtered == 0 then
        targetLabel.Text = "No players available"
        return
    end

    currentIndex += 1

    if currentIndex > #filtered then
        currentIndex = 1
    end

    updateSpectate(filtered[currentIndex])
end)

-- Stop Button
stopButton.MouseButton1Click:Connect(stopSpectating)

-- Keep Camera Following Target
local renderConnection
renderConnection = RunService.RenderStepped:Connect(function()
    if not screenGui.Parent then
        renderConnection:Disconnect()
        return
    end

    if not spectatingPlayer then
        return
    end

    if spectatingPlayer.Parent ~= Players then
        stopSpectating()
        return
    end

    local character = spectatingPlayer.Character
    local humanoid = character
        and character:FindFirstChildOfClass("Humanoid")

    camera = workspace.CurrentCamera

    if humanoid and camera
    and camera.CameraSubject ~= humanoid then
        camera.CameraType = Enum.CameraType.Custom
        camera.CameraSubject = humanoid
    end
end)

-- Dragging System
local dragging = false
local dragStart
local startPos
local dragInput

local function updateDrag(input)
    local delta = input.Position - dragStart

    mainFrame.Position = UDim2.new(
        startPos.X.Scale,
        startPos.X.Offset + delta.X,
        startPos.Y.Scale,
        startPos.Y.Offset + delta.Y
    )
end

titleLabel.Active = true

titleLabel.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then

        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

titleLabel.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

local dragConnection
dragConnection = UserInputService.InputChanged:Connect(function(input)
    if not screenGui.Parent then
        dragConnection:Disconnect()
        return
    end

    if dragging and input == dragInput then
        updateDrag(input)
    end
end)
